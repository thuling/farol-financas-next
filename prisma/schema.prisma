generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserWorkspace {
  id                 String        @id
  name               String
  plan               String        @default("Plano pessoal")
  monthlySalaryCents Int           @default(0)
  salaryDay          Int           @default(5)
  monthlyBudgetCents Int           @default(0)
  emergencyGoalCents Int           @default(33000)
  theme              String        @default("dark")
  hideValues         Boolean       @default(false)
  lastUsedAccountId  String?
  stateJson          String        @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  transactions       Transaction[]
}

model Transaction {
  id           String        @id
  userId       String
  user         UserWorkspace @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  amountCents  Int
  description  String
  tag          String        @default("")
  categoryId   String
  accountId    String
  date         String
  method       String
  externalId   String?       @unique
  createdAt    DateTime      @default(now())

  @@index([userId, date])
}
