# Banco de dados PostgreSQL (Vercel Postgres / Neon)
DATABASE_URL="postgresql://usuario:senha@host:5432/farol?sslmode=require"

# Segredo criptográfico obrigatório em produção (mínimo 32 caracteres aleatórios)
AUTH_SECRET="substitua-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres"

# Opcional: e-mails extras autorizados no /admin separados por vírgula
ADMIN_EMAILS=""

# Envio de códigos 2FA (SMTP ou Resend)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
RESEND_API_KEY=""

# Opcional: IA Gemini para leitura de faturas PDF/Imagem
GEMINI_API_KEY=""

# Open Finance (Pluggy - obrigatório definir PLUGGY_WEBHOOK_SECRET se habilitar webhooks)
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
PLUGGY_WEBHOOK_SECRET=""
